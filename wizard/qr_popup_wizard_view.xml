<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qr_code_checkout" model="ir.ui.view">
        <field name="name">qr.popup.wizard.form</field>
        <field name="model">qr.popup.wizard</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <form string="Popup Form">
                <!-- qr_poll.js polls the payment status using this transaction id -->
                <div class="alert alert-info" style="text-align: center; margin-bottom: 0.8rem;">
                    <div class="o_form_label" style="font-weight: 600; display: inline-block; margin-right: .5rem;">Transaction ID:</div>
                    <field name="transaction_id" readonly="1"/>
                    <div invisible="not payment_method_name">
                        <field name="payment_method_name" readonly="1" nolabel="1"/>
                        <field name="amount" readonly="1" nolabel="1" class="ms-2"/>
                    </div>
                </div>

                <div class="d-flex justify-content-center" style="text-align: center;">
                    <field name="qr_image" widget="image" style="width: 100%; height: auto;"/>
                </div>

                <!-- Same block for every online method: the customer opens this page
                     instead of being handed the provider link. Odoo 18 has no
                     CopyClipboardText, so the text and the copy button are two nodes
                     on the same field, and the button copies both lines. -->
                <div class="text-center mt-3" invisible="not order_link_text">
                    <div class="d-inline-flex align-items-center gap-2">
                        <field name="order_link_text" readonly="1" nolabel="1"
                               class="mb-0 text-center" style="white-space: pre-line;"/>
                        <field name="order_link_text" widget="CopyClipboardButton"
                               string="Copy" nolabel="1"/>
                    </div>
                </div>

                <div class="text-muted text-center mt-3">
                    Waiting for payment... this window closes by itself once the payment is confirmed.
                </div>

                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

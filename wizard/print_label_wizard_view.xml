<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_label_wizard_form" model="ir.ui.view">
        <field name="name">print.label.wizard.form</field>
        <field name="model">print.label.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="user_step_id" readonly="1" force_save="1"/>
                    <field name="print_barcode" invisible="1"/>
                    <field name="print_qrcode" invisible="1"/>
                    <field name="barcode_value" invisible="not print_barcode" required="print_barcode"/>
                    <field name="qrcode_value" invisible="not print_qrcode" required="print_qrcode"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

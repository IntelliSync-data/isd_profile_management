<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_label_wizard_form" model="ir.ui.view">
        <field name="name">print.label.wizard.form</field>
        <field name="model">print.label.wizard</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <form string="Print Label">
                <group>
                    <group>
                        <field name="user_step_id" readonly="1"/>
                        <field name="step_name" invisible="1"/>
                        <field name="print_height" readonly="1"/>
                    </group>
                    <group>
                        <field name="tracking_number"/>
                        <field name="print_width" readonly="1"/>
                        <field name="print_code_type" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

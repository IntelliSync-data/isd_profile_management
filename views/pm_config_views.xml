<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pm" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pm_config</field>
        <field name="model">res.config.settings</field>
        <!-- <field name="priority" eval="100"/> -->
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
            <!-- <form string="PM Settings"> -->
                <app data-string="Profile Management"
                    string="Profile Management"
                    name="isd_profile_management">
                    <div class="app_settings_block" data-string="Payment Configuration" string="Payment Configuration" data-key="payment_config" groups="base.group_user">
                        <h2>Payment Configuration</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="pm_payment_method_ids"/>
                                    <div class="text-muted">
                                        Select payment methods configured in ISD Payment module
                                    </div>
                                    <field name="pm_payment_method_ids" widget="many2many_tags" class="mt-2"/>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="app_settings_block" data-string="General" string="General" data-key="general" groups="base.group_user">
                        <h2>General</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"></div>
                                <div class="o_setting_right_pane">
                                    <label for="pm_currency"/>
                                    <div class="text-muted">Currency of package prices</div>
                                    <field name="pm_currency" class="mt-2"/>
                                    <label for="pm_exchange_rate" class="mt-3"/>
                                    <div class="text-muted">Used to convert between USD and VND when payment provider currency differs</div>
                                    <field name="pm_exchange_rate" class="mt-2"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="app_settings_block" data-string="Email Templates" string="Email Templates" data-key="email_templates" groups="base.group_user">
                        <h2>Email Notification Templates</h2>
                        <div class="alert alert-info" role="alert">
                            <strong>Note:</strong> Configure email templates for customer notifications. Assignment emails to internal users are sent separately.
                        </div>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="pm_email_order_template_id"/>
                                    <div class="text-muted">
                                        Email sent to customer when a new package order is created
                                    </div>
                                    <field name="pm_email_order_template_id" class="mt-2"/>
                                    <div class="alert alert-secondary mt-2 small" role="alert">
                                        <strong>Available variables for template Variable Keys:</strong><br/>
                                        <code>user_name</code> - Customer name<br/>
                                        <code>user_email</code> - Customer email<br/>
                                        <code>package_name</code> - Package name<br/>
                                        <code>profile_name</code> - Profile assignment name<br/>
                                        <code>total_cost</code> - Total cost (formatted, e.g. 4,000 VND)<br/>
                                        <code>paid_amount</code> - Amount already paid<br/>
                                        <code>remaining_amount</code> - Remaining amount<br/>
                                        <code>state</code> - Profile stage (new, in_progress, ...)<br/>
                                        <code>payment_status</code> - Payment status (not_yet_paid, half_paid, paid, returned)<br/>
                                        <code>assigned_date</code> - Assignment date
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="pm_email_payment_template_id"/>
                                    <div class="text-muted">
                                        Email sent to customer when payment is confirmed
                                    </div>
                                    <field name="pm_email_payment_template_id" class="mt-2"/>
                                    <div class="alert alert-secondary mt-2 small" role="alert">
                                        <strong>Available variables for template Variable Keys:</strong><br/>
                                        <code>user_name</code> - Customer name<br/>
                                        <code>user_email</code> - Customer email<br/>
                                        <code>payment_name</code> - Payment reference (e.g. PAY00001)<br/>
                                        <code>amount</code> - Payment amount (formatted, e.g. 2,000 VND)<br/>
                                        <code>transaction_id</code> - Transaction ID<br/>
                                        <code>qr_url</code> - QR code URL<br/>
                                        <code>state</code> - Payment state (draft, pending, confirmed, ...)<br/>
                                        <code>payment_date</code> - Payment date<br/>
                                        <code>package_name</code> - Package name<br/>
                                        <code>profile_name</code> - Profile assignment name
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="pm_send_assignment_emails"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="pm_send_assignment_emails"/>
                                    <div class="text-muted">
                                        Enable to send assignment/activity emails to end users. If disabled, only internal users receive these notifications.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            <!-- </form> -->
            </xpath>
        </field>
    </record>

    <record id="action_pm_settings_config" model="ir.actions.act_window">
        <field name="name">PM Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'isd_profile_management'}</field>
    </record>
</odoo>

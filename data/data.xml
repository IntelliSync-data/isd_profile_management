<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Payment References -->
        <record id="seq_profile_payment" model="ir.sequence">
            <field name="name">Profile Payment</field>
            <field name="code">profile.payment</field>
            <field name="prefix">PAY</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <data>
        <!-- A re-checkout cancels the old payment, but its QR or link can still be
             paid at every provider except ACB -->
        <record id="cron_sync_cancelled_payments" model="ir.cron">
            <field name="name">Profile Management: Recover Payments on Cancelled Transactions</field>
            <field name="model_id" ref="model_profile_payment"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_cancelled_payments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
